# Copie para .env.local e preencha com os dados do seu projeto no Supabase
# (Project Settings → API). Sem estas variáveis, o app roda em modo local, sem login,
# com a assinatura liberada, para testar as telas.
VITE_SUPABASE_URL=https://SEU-PROJETO.supabase.co
VITE_SUPABASE_ANON_KEY=sua-chave-anon-ou-publishable
