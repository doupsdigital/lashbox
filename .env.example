# Copie para .env.local e preencha com os dados do seu projeto no Supabase
# (Project Settings → API). Sem estas variáveis, o app roda em modo local, sem login,
# com a assinatura liberada, para testar as telas.
VITE_SUPABASE_URL=https://SEU-PROJETO.supabase.co
VITE_SUPABASE_ANON_KEY=sua-chave-anon-ou-publishable

# PostHog (análise de uso + gravação de sessão, ver CLAUDE.md seção 12). Sem estas duas
# variáveis, o PostHog simplesmente não carrega — nada quebra.
VITE_POSTHOG_KEY=phc_sua-chave-do-projeto
VITE_POSTHOG_HOST=https://us.i.posthog.com
